<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_night"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ov_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="墨麒麟记账"
            android:textColor="#F2F2F2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ov_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8月"
            android:textColor="#AEAFB5"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ov_income"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="收 ¥0.00"
        android:textColor="#34C759"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ov_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="支 ¥0.00"
        android:textColor="#FF9500"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ov_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="余 ¥0.00"
            android:textColor="#F2F2F2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ov_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:paddingBottom="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:text="记一笔"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
